    "row1": { "x": 0, "y": 40, "text": "1 · First time and sign-in", "kind": "title1", "maxW": 3210 },
    "row2": { "x": 0, "y": 1340, "text": "2 · Home and async duels", "kind": "title1", "maxW": 3210 },
    "row3": { "x": 0, "y": 2640, "text": "3 · Daily, party rooms and practice", "kind": "title1", "maxW": 3210 },
    "row4": { "x": 0, "y": 3940, "text": "4 · Leaderboards, friends, profile and shop", "kind": "title1", "maxW": 3210 },
    "row5": { "x": 0, "y": 5240, "text": "5 · Web app: every link plays without installing", "kind": "title1", "maxW": 3210 },
    "row6": { "x": 0, "y": 6540, "text": "6 · Admin console (staff only)", "kind": "title1", "maxW": 3210 },
    "about1": { "x": -520, "y": 300, "w": 420, "size": "m", "text": "These are design mockups, not the built app. They're drawn from docs 05 (UX and screen specs), 03 (game design), 11 (prices) and 18 (admin console). The Expo app itself is build step 1.4. Names, scores and numbers are sample data; questions come from the seed file (drafts, not fact-checked yet).\n\nBackend already built for this row: guest, phone, Google and Apple sign-in, and the age gate (steps 1.2a and 1.2b)." },
    "about2": { "x": -520, "y": 1600, "w": 420, "size": "m", "text": "Backend built: async duels with category picks, server timing, the tie-break, rematch and ratings (step 1.1).\n\nStill to come: 'your turn' pushes and share cards (step 2.5), coins and lifelines (step 2.4)." },
    "about3": { "x": -520, "y": 2900, "w": 420, "size": "m", "text": "Not built yet: the Daily challenge (step 2.1), party rooms and the web party client (step 2.2), offline practice packs (step 2.8)." },
    "about4": { "x": -520, "y": 4200, "w": 420, "size": "m", "text": "Backend built: friends, blocks, profiles and usernames (step 1.2b).\n\nPlanned: leaderboards (step 2.1), coins, shop and Sabi Pass (step 2.4), Data Saver and account deletion (step 2.8)." },
    "about5": { "x": -520, "y": 5500, "w": 420, "size": "m", "text": "The web app comes from the same code as the phone app (step 1.4). On a computer the tab bar becomes a side menu and players can answer with the keys 1 to 4. The light party client for guests is step 2.2." },
    "about6": { "x": -520, "y": 6800, "w": 420, "size": "m", "text": "admin.whosabi.ng, staff sign-in only. Search and User 360 come first (step 1.5); the other modules follow in step 2.7. Phone numbers stay masked until someone reveals them with a reason, and every look is logged." }
  },
