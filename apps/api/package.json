{
  "name": "@whosabi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core API (Fastify): auth, content, rounds and duels, plus the worker that runs their background jobs; the Daily and the admin API come next.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "build": "tsup",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:e2e": "tsx --env-file-if-exists=.env src/scripts/e2e-db.ts",
    "admin:add": "tsx --env-file-if-exists=.env src/scripts/admin-add.ts",
    "keys": "tsx src/scripts/keys.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/node": "11.10.0",
    "@whosabi/analytics": "workspace:*",
    "@whosabi/game-rules": "workspace:*",
    "@whosabi/ingest": "workspace:*",
    "@whosabi/shared-types": "workspace:*",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "1.5.4",
    "satori": "0.33.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
