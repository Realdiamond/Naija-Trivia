{
  "name": "@whosabi/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core API (Fastify): auth, content, rounds and duels; the Daily and the admin API come next.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts src/scripts/migrate.ts src/scripts/seed.ts --format esm --target node22 --clean --no-external @whosabi/",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@whosabi/analytics": "workspace:*",
    "@whosabi/game-rules": "workspace:*",
    "@whosabi/shared-types": "workspace:*",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
