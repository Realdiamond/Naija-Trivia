# Copy to .env for local development (docker compose up -d starts Postgres and Redis).
DATABASE_URL=postgres://whosabi:whosabi@localhost:5432/whosabi
REDIS_URL=redis://localhost:6379
PORT=3000
LOG_LEVEL=info
# The Expo dev server (web) and the default Expo web port.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Secure cookies work on http://localhost in Chrome; set false only when testing from another device over plain HTTP.
COOKIE_SECURE=true
# Duel invite links are {PUBLIC_WEB_URL}/d/{token}.
PUBLIC_WEB_URL=http://localhost:8081
# Sign-in. With no SMS keys, development writes sign-in codes to the log instead of sending them.
# TERMII_API_KEY=
# TERMII_SENDER_ID=WhoSabi
# AT_USERNAME=
# AT_API_KEY=
# SMS_RETRIEVER_APP_HASH=
# Outside production any non-empty Turnstile token passes when TURNSTILE_SECRET is unset.
# TURNSTILE_SECRET=
# Comma-separated OAuth client ids / Apple audiences; empty turns that sign-in method off.
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=
# Production also needs JWT_PRIVATE_KEY, JWT_PUBLIC_KEY (ES256 PEM), ANALYTICS_KEY and OTP_SECRET
# (32+ characters each), TURNSTILE_SECRET, and Termii or Africa's Talking keys.
