# Copy to .env for local development (docker compose up -d starts Postgres and Redis).
# The API (pnpm dev) and the worker (pnpm dev:worker) read the same settings.
DATABASE_URL=postgres://whosabi:whosabi@localhost:5432/whosabi
REDIS_URL=redis://localhost:6379
PORT=3000
LOG_LEVEL=info
# The Expo dev server (web) and the default Expo web port.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Secure cookies work on http://localhost in Chrome; set false only when testing from another device over plain HTTP.
COOKIE_SECURE=true
# Duel invite links are {PUBLIC_WEB_URL}/d/{token}.
PUBLIC_WEB_URL=http://localhost:8081
# Sign-in. With no SMS keys, development writes sign-in codes to the log instead of sending them,
# and production turns phone sign-in off.
# TERMII_API_KEY=
# TERMII_SENDER_ID=WhoSabi
# AT_USERNAME=
# AT_API_KEY=
# SMS_RETRIEVER_APP_HASH=
# Outside production any non-empty Turnstile token passes when TURNSTILE_SECRET is unset.
# TURNSTILE_SECRET=
# Comma-separated OAuth client ids / Apple audiences; empty turns that sign-in method off.
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=
# Staff sign-in to the admin console: its own Google OAuth client id, and optionally the Google
# Workspace domain every staff account must belong to. Add the first owner with
#   pnpm --filter @whosabi/api admin:add you@example.com "Your Name" owner
ADMIN_GOOGLE_CLIENT_IDS=
# ADMIN_GOOGLE_DOMAIN=whosabi.ng
# Days the worker keeps raw analytics events before only the daily counts remain.
ANALYTICS_RETENTION_DAYS=60
# Production also needs JWT_PRIVATE_KEY, JWT_PUBLIC_KEY (ES256 PEM) and ANALYTICS_KEY (32+ characters).
# Phone sign-in in production also needs Termii or Africa's Talking keys, OTP_SECRET (32+ characters)
# and TURNSTILE_SECRET.
