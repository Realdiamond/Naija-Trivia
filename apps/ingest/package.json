{
  "name": "@whosabi/ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Analytics event intake: checks client batches against the tracking plan and consent, accepts each batch once, and appends it to the Redis stream (doc 18 §15).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@whosabi/analytics": "workspace:*",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
