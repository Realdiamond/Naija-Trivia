# Copy to .env.local for `pnpm --filter @whosabi/admin dev` (the console on http://localhost:3002).
# The core API; the console calls it from its server, never from the browser.
API_URL=http://localhost:3000
# The console's Google OAuth web client id (the API's ADMIN_GOOGLE_CLIENT_IDS must include it).
ADMIN_GOOGLE_CLIENT_ID=
# Development only: sign in by email without Google. The API has no such route in production.
ADMIN_DEV_SIGN_IN=true
