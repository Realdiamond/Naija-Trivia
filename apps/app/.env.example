# Copy to .env. Expo builds EXPO_PUBLIC_* values into the app, so restart the dev server after a change.

# The API. On a phone with Expo Go, use your computer's Wi-Fi address, like http://192.168.1.20:3000.
# Leave it empty when the web app is served from the API's own address (same origin).
EXPO_PUBLIC_API_URL=http://localhost:3000
# The analytics intake (apps/ingest).
EXPO_PUBLIC_EVENTS_URL=http://localhost:3001
# Google sign-in on the web: a Google OAuth web client id, also listed in the API's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Cloudflare Turnstile site key for phone codes on the web; empty in development.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
